{
  "openapi": "3.1.0",
  "info": {
    "title": "Broccoli Hybrid Control Plane",
    "version": "0.1.0",
    "description": "mTLS required on every endpoint. OAuth2 access tokens are certificate-bound per RFC 8705. Hosted model clients without certificate support must use an owned runner."
  },
  "security": [
    {
      "mutualTLS": [],
      "oauth": [
        "jobs:read"
      ]
    }
  ],
  "components": {
    "securitySchemes": {
      "mutualTLS": {
        "type": "mutualTLS"
      },
      "oauth": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "/oauth/token",
            "scopes": {
              "jobs:read": "Read own results",
              "jobs:write": "Submit authorized tasks"
            }
          }
        }
      }
    },
    "schemas": {
      "JobRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "operation",
          "arguments",
          "deadline"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "operation": {
            "type": "string",
            "enum": [
              "status",
              "snapshot",
              "tap",
              "key",
              "launch",
              "run",
              "provision"
            ]
          },
          "arguments": {
            "type": "object"
          },
          "deadline": {
            "type": "number",
            "description": "Unix epoch seconds; future, at most 24 hours"
          }
        }
      }
    }
  },
  "paths": {
    "/oauth/token": {
      "post": {
        "operationId": "issueToken",
        "security": [
          {
            "mutualTLS": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "grant_type",
                  "client_id",
                  "scope"
                ],
                "properties": {
                  "grant_type": {
                    "const": "client_credentials"
                  },
                  "client_id": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Certificate-bound 300-second bearer token"
          },
          "401": {
            "description": "Unregistered certificate or denied scope"
          }
        }
      }
    },
    "/v1/jobs": {
      "post": {
        "operationId": "submitJob",
        "security": [
          {
            "mutualTLS": [],
            "oauth": [
              "jobs:write"
            ]
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Persisted job, not completed execution"
          },
          "400": {
            "description": "Invalid input, conflicting idempotency key or queue capacity"
          },
          "401": {
            "description": "Invalid credentials or forbidden target/operation"
          },
          "429": {
            "description": "Certificate request limit reached"
          }
        }
      }
    },
    "/v1/jobs/{id}": {
      "get": {
        "operationId": "getJob",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job state and bounded output"
          },
          "404": {
            "description": "Unknown or not owned by client"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Authenticated health and queue count"
          }
        }
      }
    }
  }
}
